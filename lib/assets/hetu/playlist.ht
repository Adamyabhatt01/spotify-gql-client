import "module:std" as std
import { SpotifyError } from "error.ht"

var HttpClient = std.HttpClient
var HttpResponse = std.HttpResponse

class SpotifyPlaylistEndpoint {
  var apiClient: HttpClient
  var gqlClient: HttpClient
  var spClient: HttpClient

  construct (this.apiClient, this.gqlClient, this.spClient)

  fun getPlaylist(playlistId: string) {
    return this.gqlClient.post(
      "",
      data: {
        "variables": {
          "uri": "spotify:playlist:${playlistId}",
          "offset": 0,
          "limit": 25,
          "enableWatchFeedEntrypoint": true
        },
        "operationName": "fetchPlaylist",
        "extensions": {
          "persistedQuery": {
            "version": 1,
            "sha256Hash": "bb67e0af06e8d6f52b531f97468ee4acd44cd0f82b988e15c2ea47b1148efc77"
          }
        }
      }.toJson()
    ).then((res: HttpResponse) {
      var data = res.data

      if (SpotifyError.isError(data)) {
        throw SpotifyError(data)
      }
      var playlist = data["data"]["playlistV2"]
      var owner = playlist["ownerV2"]["data"]
      var imageItems = playlist["images"]?["items"]
      var images = []
      if (imageItems != null && imageItems.length > 0) {
        images = imageItems[0]?["sources"] ?? []
      }

      return {
        id: playlistId,
        collaborative: playlist["members"]["items"].length > 1,
        description: playlist["description"] ?? "",
        external_urls: {
          spotify: "https://open.spotify.com/playlist/${playlistId}"
        },
        followers: playlist["followers"],
        name: playlist["name"],
        images: images,
        public: true,
        owner: {
          id: owner["uri"].split(":").last,
          external_urls: {
            spotify: "https://open.spotify.com/user/${owner["uri"].split(":").last}"
          },
          type: "user",
          uri: owner["uri"],
          display_name: owner["name"],
          images: owner["avatar"]?["sources"] ?? []
        }
      }.toJson()
    })
  }

  fun tracks(playlistId: string, {offset: int, limit: int}) {    
    return this.gqlClient.post(
      "",
      data: {
        "variables": {
          "uri": "spotify:playlist:${playlistId}",
          "offset": offset ?? 0,
          "limit": limit ?? 25,
          "enableWatchFeedEntrypoint": false
        },
        "operationName": "fetchPlaylist",
        "extensions": {
          "persistedQuery": {
            "version": 1,
            "sha256Hash": "bb67e0af06e8d6f52b531f97468ee4acd44cd0f82b988e15c2ea47b1148efc77"
          }
        }
      }.toJson()
    ).then((res: HttpResponse) {
      var data = res.data

      if (SpotifyError.isError(data)) {
        throw SpotifyError(data)
      }
      var playlist = data["data"]["playlistV2"]
      var owner = playlist["ownerV2"]["data"]
      // Empty/unavailable playlists omit `content` (or its `items`) — treat
      // as zero tracks. Only Track-shaped entries pass: episodes resolve
      // `itemV2.data` to a *non-null* Episode object, so a null check is not
      // enough — discriminate on the `spotify:track` uri prefix. Local and
      // filtered rows (null data or null uri) fail the same predicate.
      // Skipped entries never reach the Track-only dereferences below; a
      // single episode used to reject the whole tracks() future instead.
      var tracks = (playlist["content"]?["items"] ?? []).where((track) {
        var data = track != null ? track["itemV2"]?["data"] : null
        return data != null && (data["uri"] ?? "").startsWith("spotify:track")
      }).map((track){
        var item = track["itemV2"]["data"]
        // This map runs before the track-level guards below, so a throw here
        // rejected the whole page exactly like the episode case. A Track always
        // selects artists.items, but a row can still carry a null entry or one
        // without a uri/profile — drop those and keep the track. If nothing
        // survives, trackArtists is empty and the track is skipped below.
        var trackArtists = (item["artists"]?["items"] ?? []).where((artist) {
          return artist != null && artist["uri"] != null &&
              artist["profile"]?["name"] != null
        }).map((artist){
          var id = artist["uri"].split(":").last
          return {
            id: id,
            uri: artist["uri"],
            name: artist["profile"]["name"],
            external_urls: {
              spotify: "https://open.spotify.com/artist/${id}",
            },
          }.toJson()
        }).toList()

        // A malformed track (no album uri, no artists) degrades to a skip
        // rather than killing the page — same policy as non-track entries.
        var albumUri = item["albumOfTrack"]?["uri"]
        if (albumUri == null || trackArtists.length == 0) return null

        var albumId = albumUri.split(":").last

        return {
          id: item["uri"].split(":").last,
          uri: item["uri"],
          name: item["name"],
          album: {
            album_type: "album",
            id: albumId,
            name: item["albumOfTrack"]["name"],
            images: item["albumOfTrack"]["coverArt"]?["sources"] ?? [],
            external_urls: {
              spotify: "https://open.spotify.com/album/${albumId}",
            },
            href: "https://api.spotify.com/v1/albums/${albumId}",
            artists: [trackArtists[0]]
          },
          artists: trackArtists,
          // fetchPlaylist selects the length as `trackDuration`; the other
          // overview operations select `duration`. A miss is silent: the
          // converter does `?? 0`, so the row renders as 0:00.
          duration_ms: item["duration"]?["totalMilliseconds"] ??
              item["trackDuration"]?["totalMilliseconds"] ??
              item["duration_ms"],
          external_urls: {
            spotify: "https://open.spotify.com/track/${item["uri"].split(":").last}",
          },
        }.toJson()
      }).where((converted) {
        return converted != null
      }).toList()

      return {
        href: "https://api.spotify.com/v1/playlists/${playlistId}/tracks?offset=${offset ?? 0}&limit=${limit ?? 20}",
        limit: limit ?? 50,
        offset: offset ?? 0,
        total: (playlist["content"]?["totalCount"] ?? 0),
        next: tracks.length < (limit ?? 50) ? "https://api.spotify.com/v1/playlists/${playlistId}/tracks?offset=${(offset ?? 0) + tracks.length}&limit=${limit ?? 50}" : null,
        previous: offset != null && offset > 0 ? "https://api.spotify.com/v1/playlists/${playlistId}/tracks?offset=${Math.max(0, (offset ?? 0) - (limit ?? 50))}&limit=${limit ?? 50}" : null,
        items: tracks,
      }.toJson()
    })
  }

  fun create(userId: string, {
    name: string,
    description: string,
    public: bool,
    collaborative: bool
  }) {
    assert(name != null && userId != null)

    // The web player creates an empty playlist through spclient with an
    // UPDATE_LIST_ATTRIBUTES op. api.spotify.com/v1/users/{id}/playlists is
    // the same write bucket that currently answers 429 for this account.
    var values = { name: name }.toJson()
    if (description != null) {
      values["description"] = description
    }

    return this.spClient.post(
      "/playlist/v2/playlist?format=json",
      data: {
        ops: [
          {
            kind: "UPDATE_LIST_ATTRIBUTES",
            updateListAttributes: {
              newAttributes: {
                values: values
              }
            }
          }
        ]
      }.toJson()
    ).then((res: HttpResponse) {
      var data = res.data

      if (SpotifyError.isError(data)) {
        throw SpotifyError(data)
      }
      if (data == null || data["uri"] == null) {
        throw "Spotify did not return the created playlist URI"
      }

      var uri = data["uri"]
      var playlistId = uri.split(":").last

      // spclient create does not put the new playlist in the library
      // rootlist. Follow it first so it exists on other clients, then apply
      // the requested visibility.
      return this.follow(playlistId).then((_) {
        if (public != null) {
          return this.changePermission(userId, uri, public).then((_) {
            return this.getPlaylist(playlistId)
          })
        }
        return this.getPlaylist(playlistId)
      })
    })
  }

  fun update(playlistId: string, {
    name: string,
    description: string,
    public: bool,
    collaborative: bool
  }) {
    assert(playlistId != null)

    var values = {}.toJson()
    if (name != null) {
      values["name"] = name
    }
    if (description != null) {
      values["description"] = description
    }

    return this.spClient.post(
      "/playlist/v2/playlist/${playlistId}/changes?format=json",
      data: {
        deltas: [
          {
            ops: [
              {
                kind: "UPDATE_LIST_ATTRIBUTES",
                updateListAttributes: {
                  newAttributes: {
                    values: values
                  }
                }
              }
            ],
            info: {
              source: {
                client: "WEBPLAYER"
              }
            }
          }
        ]
      }.toJson()
    ).then((res: HttpResponse) {
      var data = res.data

      if (SpotifyError.isError(data)) {
        throw SpotifyError(data)
      }
    })
  }

  fun addTracks(playlistId: string, {uris: List, position: int}) {
    assert(uris != null && playlistId != null)

    // GQL addToPlaylist appends to the bottom. The host does not request
    // positional inserts today; keeping the REST v1 endpoint here would put
    // track adds back on the 429 bucket.
    return this.gqlClient.post(
      "",
      data: {
        variables: {
          playlistItemUris: uris,
          playlistUri: "spotify:playlist:${playlistId}",
          newPosition: {
            moveType: "BOTTOM_OF_PLAYLIST",
            fromUid: null
          }
        },
        operationName: "addToPlaylist",
        extensions: {
          persistedQuery: {
            version: 1,
            sha256Hash: "47b2a1234b17748d332dd0431534f22450e9ecbb3d5ddcdacbd83368636a0990"
          }
        }
      }.toJson()
    ).then((res: HttpResponse) {
      var data = res.data

      if (SpotifyError.isError(data)) {
        throw SpotifyError(data)
      }

      return data
    })
  }

  fun changePermission(userId: string, playlistUri: string, isPublic: bool) {
    return this.spClient.post(
      "/playlist/v2/user/${userId}/rootlist/changes?format=json",
      data: {
        deltas: [
          {
            ops: [
              {
                kind: "UPDATE_ITEM_ATTRIBUTES",
                updateItemAttributes: {
                  newAttributes: {
                    values: {
                      public: isPublic
                    }
                  },
                  item: {
                    uri: playlistUri
                  }
                }
              }
            ],
            info: {
              source: {
                client: "WEBPLAYER"
              }
            }
          }
        ]
      }.toJson()
    ).then((res: HttpResponse) {
      var data = res.data

      if (SpotifyError.isError(data)) {
        throw SpotifyError(data)
      }

      return data
    })
  }

  fun removeTracks(playlistId: string, {uris: List}) {
    assert(uris != null && playlistId != null)

    return this.apiClient.delete_req(
      "/playlists/${playlistId}/tracks",
      data: {
        tracks: uris.map((uri)=>{uri: uri}).toList()
      }.toJson()
    ).then((res: HttpResponse) {
      var data = res.data

      if (SpotifyError.isError(data)) {
        throw SpotifyError(data)
      }

      return data
    })
  }

  fun follow(playlistId: string) {
    return this.gqlClient.post(
      "",
      data: {
        variables: {
          uris: ["spotify:playlist:${playlistId}"]
        },
        operationName: "addItemsToRootlist",
        extensions: {
          persistedQuery: {
            version: 1,
            sha256Hash: "bd9c5cae1ee80ebca05d7ed12fd394216f49a20ce72d9dc762868df0f14522ea"
          }
        }
      }.toJson()
    ).then((res: HttpResponse){
      var data = res.data
      if(SpotifyError.isError(data)) {
        throw SpotifyError(data)
      }
      return data
    })
  }

  fun unfollow(playlistId: string) {
    return this.gqlClient.post(
      "",
      data: {
        variables: {
          uris: ["spotify:playlist:${playlistId}"]
        },
        operationName: "removeItemsFromRootlist",
        extensions: {
          persistedQuery: {
            version: 1,
            sha256Hash: "3422f1866532820a1d8d0560f88542dbdbd35d0377ee5ecd49593590f5f1e86b"
          }
        }
      }.toJson()
    ).then((res: HttpResponse){
      var data = res.data
      if(SpotifyError.isError(data)) {
        throw SpotifyError(data)
      }
      return data
    })
  }
}

export { SpotifyPlaylistEndpoint }